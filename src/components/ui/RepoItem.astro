---
// One distro in the package panel: its name and package manager, then its commands, which
// slide open (site.js keeps one open at a time). The slot goes above the commands.
import Chevron from "./Chevron.astro";
import Commands from "./Commands.astro";

interface Props {
  id: string;
  name: string;
  manager: string;
  commands: string;
}
const { id, name, manager, commands } = Astro.props;
---

<div class="repo open" data-repo>
  <h3>
    <button
      type="button"
      class="repo-head flex w-full items-center gap-3 rounded-2xl px-5 py-4 text-left text-[16px] font-bold text-text"
      id={`repo-${id}-h`}
      aria-expanded="true"
      aria-controls={`repo-${id}`}
    >
      <span class="distro">{name}</span>
      <span class="rounded-full border border-edge px-2.5 py-0.5 text-[12px] font-semibold text-muted">{manager}</span>
      <Chevron class="ml-auto flex-none" />
    </button>
  </h3>
  <div class="fold" id={`repo-${id}`} role="region" aria-labelledby={`repo-${id}-h`}>
    <div class="fold-inner">
      <slot />
      <Commands id={`cmd-${id}`} text={commands} class="mx-4 mb-4" />
    </div>
  </div>
</div>
