---
// A small, live Home: game cards to move through with the arrow keys, the mouse or a finger,
// and a download whose progress shows in the top bar, as the launcher's does. The games are
// made up, so no game's art is copied; the picture behind them is the real Home's. site.js runs
// it. Its block in Screenshots.astro stays hidden without the script.

// `art` is two colours for the cover. `state` is "ready", or "get" for a game that downloads.
const games = [
  { title: "Lantern Valley", system: "Switch", size: "3.1 GB", art: ["#f2a65a", "#1f6f78"], state: "ready" },
  { title: "Moonlit Drift", system: "PS5", size: "18.6 GB", art: ["#a78bfa", "#1e3a8a"], state: "ready" },
  { title: "Tidewalker", system: "PS4", size: "22.0 GB", art: ["#5eead4", "#0f4c75"], state: "get" },
  { title: "Copper Knights", system: "PC", size: "7.4 GB", art: ["#fb923c", "#4a2511"], state: "ready" },
  { title: "Neon Orchard", system: "Steam", size: "1.2 GB", art: ["#f472b6", "#3b0764"], state: "ready" },
  { title: "Skyward Post", system: "Switch", size: "5.5 GB", art: ["#93c5fd", "#334155"], state: "get" },
];
---

<div class="demo" data-demo>
  <div class="demo-bg" aria-hidden="true"></div>
  <div class="demo-bar">
    <p class="demo-download" data-demo-download hidden>
      <span data-demo-download-text>Downloading</span>
      <span class="demo-meter" aria-hidden="true">
        <span data-demo-meter></span>
      </span>
    </p>
    <span class="demo-icons" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="6"></circle>
        <path d="M20 20l-4.5-4.5"></path>
      </svg>
      <svg viewBox="0 0 24 24">
        <path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path>
      </svg>
      <svg viewBox="0 0 24 24">
        <path d="M7 8h10a4 4 0 0 1 4 4v3a3 3 0 0 1-5.4 1.8L14 15h-4l-1.6 1.8A3 3 0 0 1 3 15v-3a4 4 0 0 1 4-4z"></path>
      </svg>
      <svg viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="8"></circle>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
    </span>
    <span class="demo-clock" data-demo-clock aria-hidden="true">
      12:00
    </span>
  </div>
  <div class="demo-info" aria-hidden="true">
    <p class="demo-system" data-demo-system></p>
    <p class="demo-title" data-demo-title></p>
    <p class="demo-fact" data-demo-fact></p>
  </div>
  <ul
    class="demo-row overflow-x-auto"
    role="listbox"
    aria-orientation="horizontal"
    aria-label="Home demo: the arrow keys move between the games"
    tabindex="0"
    data-demo-row
  >
    {games.map((game, i) => (
      <li
        class="demo-card"
        role="option"
        id={`demo-game-${i}`}
        aria-selected={String(i === 0)}
        data-title={game.title}
        data-system={game.system}
        data-size={game.size}
        data-state={game.state}
        style={`--a: ${game.art[0]}; --b: ${game.art[1]}`}
      >
        <span class="demo-badge" aria-hidden="true">
          {game.system}
        </span>
        <span class="demo-name">{game.title}</span>
        <span class="visually-hidden" data-demo-say />
      </li>
    ))}
  </ul>
  <p class="demo-hints" aria-hidden="true">
    <span data-demo-play>
      <kbd>✕</kbd> Play
    </span>
    <span>
      <kbd>←</kbd>
      <kbd>→</kbd> Move
    </span>
  </p>
  <p class="visually-hidden" aria-live="polite" data-demo-news></p>
</div>
