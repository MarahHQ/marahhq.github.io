---
// The arrow that turns when its panel opens. `class` adds to the component's own `chev`.
interface Props {
  class?: string;
}
const { class: extra = "" } = Astro.props;
---

<svg class:list={["chev", extra]} viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
  <path d="M6 9l6 6 6-6"></path>
</svg>
