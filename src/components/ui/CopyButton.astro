---
// Copies the text of the element `target`. A copy icon, then a tick for a moment (site.js).
// Hidden until the script shows it: without the script it can't copy.
interface Props {
  target: string;
  label?: string;
}
const { target, label = "Copy the commands" } = Astro.props;
---

<button type="button" class="copy" data-copy={target} aria-label={label} title="Copy" hidden>
  <svg class="i-copy" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <rect x="9" y="9" width="11" height="11" rx="2"></rect>
    <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
  </svg>
  <svg class="i-done" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M5 12.5l4.5 4.5L19 7.5"></path>
  </svg>
</button>
