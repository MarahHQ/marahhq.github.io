---
// The header: the logo, the links (a slide-in menu on a tablet or a phone), GitHub and Download.
---

<header class="site-header sticky top-0 z-10">
  <!-- In the header, under the menu panel: the header is its own layer. -->
  <div class="nav-scrim" aria-hidden="true"></div>
  <div class="wrap flex min-h-20 items-center justify-between gap-6 transition-[min-height] duration-300 ease-out in-[.hdr-scrolled]:min-h-16 max-md:flex-wrap max-sm:min-h-17 max-sm:in-[.hdr-scrolled]:min-h-14">
    <a
      class="flex items-center gap-3 font-display text-[20px] leading-[1.05] font-extrabold tracking-[-.03em] text-text no-underline max-sm:text-[17px]"
      href="#top"
    >
      <img
        class="size-13 drop-shadow-[0_0_10px_rgba(130,216,245,.35)] transition-[width,height] duration-300 ease-out in-[.hdr-scrolled]:size-10 max-sm:size-10 max-sm:in-[.hdr-scrolled]:size-9"
        src="assets/logo-mark.svg"
        alt=""
        width="52"
        height="52"
        decoding="async"
      />
      <span>
        Marah
        <br />
        Launcher
      </span>
    </a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="nav" hidden>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <span class="visually-hidden">Menu</span>
    </button>
    <nav id="nav" aria-label="Main">
      <p class="nav-title">Menu</p>
      <button class="nav-close" type="button" aria-label="Close the menu">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
      <a class="nav-link" href="#get">
        Get it
      </a>
      <a class="nav-link" href="#screens">
        Screenshots
      </a>
      <a class="nav-link" href="#pad">
        Controller
      </a>
      <a class="nav-link" href="#add-game">
        Add a game
      </a>
      <a class="nav-link" href="#os">
        Marah OS
      </a>
      <a class="nav-link" href="#which">
        Which one?
      </a>
      <a class="nav-link" href="#faq">
        FAQ
      </a>
      <div class="nav-extra">
        <a class="cta" href="#download">
          Download Marah Launcher
        </a>
        <a class="btn-outline" href="https://github.com/MarahHQ">
          <svg aria-hidden="true" viewBox="0 0 16 16" width="20" height="20">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            />
          </svg>
          <span>MarahHQ on GitHub</span>
        </a>
      </div>
    </nav>
    <div class="flex items-center gap-4">
      <a
        class="grid size-11 place-items-center rounded-full bg-line text-text transition-[background-color,translate] duration-200 hover:-translate-y-0.5 hover:bg-[#26486a] focus-visible:-translate-y-0.5 focus-visible:bg-[#26486a] max-sm:hidden"
        href="https://github.com/MarahHQ"
      >
        <svg aria-hidden="true" viewBox="0 0 16 16" width="22" height="22">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          />
        </svg>
        <span class="visually-hidden">MarahHQ on GitHub</span>
      </a>
      <a class="cta small" href="#download">
        Download
      </a>
    </div>
  </div>
</header>
