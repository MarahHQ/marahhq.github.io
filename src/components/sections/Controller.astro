---
// The controller: press a key or a button, and it lights what that does. On a tablet or a phone,
// the list of keys says it instead of the lines on the drawing (site.js lights both).
const keys = [
  { act: "move", button: "D-pad, left stick", key: "Arrows", does: "Move" },
  { act: "select", button: "✕", key: "Enter", does: "Select" },
  { act: "back", button: "○", key: "Esc", does: "Back" },
  { act: "search", button: "△", key: "/", does: "Search" },
  { act: "trailer", button: "□", key: "T", does: "The game's trailer" },
  { act: "menu", button: "Options", key: "Menu", does: "The game's menu" },
  { act: "bar", button: "L1, R1", key: "Tab", does: "Along the top bar, or to the next section" },
  { act: "page", button: "L2, R2", key: "Page Up/Down", does: "A page up or down" },
  { act: "notice", button: "Create", key: "Delete", does: "Close the newest notice" },
  { act: "home", button: "PS", key: null, does: "Tap: Home. Hold: close the game, or the power menu" },
];
---

<section class="wrap border-t border-line pt-24 pb-18 max-sm:py-16" id="pad" aria-labelledby="pad-title">
  <div class="text-center" data-reveal>
    <p class="eyebrow">Made for a controller</p>
    <h2 class="mt-4 mb-3 text-section" id="pad-title">
      Press a button.
      <br />
      <span class="accent-text">See what it does.</span>
    </h2>
    <p class="mx-auto my-[1em] max-w-[640px] text-lead text-muted">
      Every screen works with a controller, a keyboard or a mouse. Try it here: plug in a controller and press a button,
      or click the controller and press a key.
    </p>
    <p
      class="mx-auto my-[1em] min-h-[3.2em] max-w-[640px] rounded-[14px] border border-line bg-panel px-4.5 py-3.5 text-lead font-semibold text-text [&_strong]:text-ice"
      data-pad-say
      aria-live="polite"
    >
      Waiting for a button.
    </p>
  </div>
  <div class="mt-6" data-reveal style="--i: 1">
    <div
      class="gamepad mx-auto w-full max-w-[1120px] rounded-3xl outline-offset-8"
      data-pad
      tabindex="0"
      role="group"
      aria-label="A controller. Press a key or a controller button to see what it does in Marah Launcher."
    >
      <!-- prettier-ignore -->
      <svg viewBox="0 0 960 440" aria-hidden="true">
  <defs>
    <linearGradient id="pad-wing" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fbfdfe"/><stop offset=".45" stop-color="#e6edf3"/><stop offset="1" stop-color="#b3c3d1"/></linearGradient>
    <radialGradient id="pad-sheen" cx=".5" cy="0" r=".8"><stop offset="0" stop-color="#fff" stop-opacity=".9"/><stop offset=".5" stop-color="#fff" stop-opacity="0"/></radialGradient>
    <linearGradient id="pad-grip" x1="0" y1="0" x2="0" y2="1"><stop offset=".55" stop-color="#000" stop-opacity="0"/><stop offset="1" stop-color="#0a1a2a" stop-opacity=".28"/></linearGradient>
    <linearGradient id="pad-core" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#202f3f"/><stop offset="1" stop-color="#0a121b"/></linearGradient>
    <linearGradient id="pad-touch" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#d8e2eb"/></linearGradient>
    <linearGradient id="pad-trigger" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3a4a5b"/><stop offset="1" stop-color="#121b25"/></linearGradient>
    <linearGradient id="pad-key" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#34414f"/><stop offset="1" stop-color="#141c25"/></linearGradient>
    <linearGradient id="pad-dkey" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#d3dde6"/></linearGradient>
    <radialGradient id="pad-well" cx=".5" cy=".45" r=".5"><stop offset=".7" stop-color="#7f95a8" stop-opacity=".22"/><stop offset="1" stop-color="#7f95a8" stop-opacity="0"/></radialGradient>
    <radialGradient id="pad-cap" cx=".42" cy=".3" r=".75"><stop offset="0" stop-color="#4a5d70"/><stop offset=".6" stop-color="#1c2732"/><stop offset="1" stop-color="#0e151c"/></radialGradient>
    <radialGradient id="pad-dish" cx=".5" cy=".62" r=".6"><stop offset="0" stop-color="#0b1118"/><stop offset="1" stop-color="#26323f"/></radialGradient>
    <clipPath id="pad-clip"><path d="M120 34C150 27 250 27 280 34C318 34 346 40 363 58C384 80 393 124 396 172C399 218 390 254 360 256C334 258 316 232 299 202C289 186 270 184 200 184S111 186 101 202C84 232 66 258 40 256C10 254 1 218 4 172C7 124 16 80 37 58C54 40 82 34 120 34Z"/></clipPath>
  </defs>
  <g transform="translate(280 90)">
    <!-- The triggers, behind the body, angled out. -->
    <g class="b l2" data-act="page"><path class="k trig" d="M30 50C32 26 48 7 76 2C100 -2 116 6 122 18L123 34Z"/><path class="edge" d="M40 26C50 14 62 7 76 4C92 1 106 5 114 11"/><text x="82" y="17">L2</text></g>
    <g class="b r2" data-act="page"><path class="k trig" d="M370 50C368 26 352 7 324 2C300 -2 284 6 278 18L277 34Z"/><path class="edge" d="M360 26C350 14 338 7 324 4C308 1 294 5 286 11"/><text x="318" y="17">R2</text></g>
    <!-- The shell: light wings around a dark core, a sheen on top, the grips in shade. -->
    <path class="shell" d="M120 34C150 27 250 27 280 34C318 34 346 40 363 58C384 80 393 124 396 172C399 218 390 254 360 256C334 258 316 232 299 202C289 186 270 184 200 184S111 186 101 202C84 232 66 258 40 256C10 254 1 218 4 172C7 124 16 80 37 58C54 40 82 34 120 34Z"/>
    <g clip-path="url(#pad-clip)">
      <rect x="0" y="20" width="400" height="140" fill="url(#pad-sheen)" opacity=".7"/>
      <rect x="0" y="0" width="400" height="270" fill="url(#pad-grip)"/>
    </g>
    <path class="core" d="M128 46H272C290 70 302 110 300 150C299 168 296 180 292 190C278 184 250 182 200 182S122 184 108 190C104 180 101 168 100 150C98 110 110 70 128 46Z"/>
    <path class="core-edge" d="M108 190C122 184 150 182 200 182S278 184 292 190"/>
    <!-- The bumpers, along the shoulders. -->
    <g class="b l1" data-act="bar"><path class="k bump" d="M31 57C48 38 80 28 122 27L123 38C86 39 58 46 41 64Z"/><path class="edge" d="M36 54C52 38 82 30 120 29"/></g>
    <g class="b r1" data-act="bar"><path class="k bump" d="M369 57C352 38 320 28 278 27L277 38C314 39 342 46 359 64Z"/><path class="edge" d="M364 54C348 38 318 30 280 29"/></g>
    <!-- The touchpad, the light bar along it, Create and Options. -->
    <path class="lightbar" d="M141 50Q138 80 146 104M259 50Q262 80 254 104"/>
    <path class="touch" d="M148 44H252Q258 44 257 52L252 100Q251 108 243 108H157Q149 108 148 100L143 52Q142 44 148 44Z"/>
    <path class="touch-hi" d="M150 47H250"/>
    <g class="b create" data-act="notice"><rect class="k" x="124" y="44" width="9" height="20" rx="4.5"/></g>
    <g class="b options" data-act="menu"><rect class="k" x="267" y="44" width="9" height="20" rx="4.5"/></g>
    <!-- The D-pad: four arrow-shaped buttons in a shallow well. -->
    <g transform="translate(-6 -8)">
    <circle class="well" cx="75" cy="110" r="38"/>
      <g class="b dp up" data-act="move"><path class="k dk" d="M68 82h14q3 0 3 3v14l-10 8-10-8v-14q0-3 3-3z"/></g>
      <g class="b dp down" data-act="move"><path class="k dk" d="M68 138h14q3 0 3-3v-14l-10-8-10 8v14q0 3 3 3z"/></g>
      <g class="b dp left" data-act="move"><path class="k dk" d="M47 103v14q0 3 3 3h14l8-10-8-10h-14q-3 0-3 3z"/></g>
      <g class="b dp right" data-act="move"><path class="k dk" d="M103 103v14q0 3-3 3h-14l-8-10 8-10h14q3 0 3 3z"/></g>
    </g>
    <!-- The face buttons, in a shallow well. -->
    <g transform="translate(336 101) scale(.9) translate(-318 -109)">
    <circle class="well" cx="318" cy="109" r="46"/>
      <g class="b fc tri" data-act="search"><circle class="k" cx="318" cy="82" r="13"/><path class="hi" d="M309 76a12 12 0 0 1 18 0"/><path class="g" d="M318 75.5l6.5 11h-13z"/></g>
      <g class="b fc cir" data-act="back"><circle class="k" cx="345" cy="109" r="13"/><path class="hi" d="M336 103a12 12 0 0 1 18 0"/><circle class="g" cx="345" cy="109" r="6"/></g>
      <g class="b fc crs" data-act="select"><circle class="k" cx="318" cy="136" r="13"/><path class="hi" d="M309 130a12 12 0 0 1 18 0"/><path class="g" d="M313 131l10 10M323 131l-10 10"/></g>
      <g class="b fc sq" data-act="trailer"><circle class="k" cx="291" cy="109" r="13"/><path class="hi" d="M282 103a12 12 0 0 1 18 0"/><rect class="g" x="285.5" y="103.5" width="11" height="11" rx="1"/></g>
    </g>
    <!-- The sticks: dished caps in their rings. -->
    <g class="b stick ls" data-act="move"><circle class="stick-ring" cx="148" cy="150" r="24"/><circle class="k cap" cx="148" cy="150" r="18"/><circle class="dish" cx="148" cy="151" r="12"/></g>
    <g class="stick rs"><circle class="stick-ring" cx="252" cy="150" r="24"/><circle class="cap" cx="252" cy="150" r="18"/><circle class="dish" cx="252" cy="151" r="12"/></g>
    <!-- The PS button, the mute light and the speaker. -->
    <g class="b ps" data-act="home"><circle class="k" cx="200" cy="142" r="10"/><text x="200" y="142">PS</text></g>
    <rect class="mute" x="193" y="160" width="14" height="4" rx="2"/>
    <g class="speaker"><circle cx="190" cy="120" r="1.1"/><circle cx="195" cy="120" r="1.1"/><circle cx="200" cy="120" r="1.1"/><circle cx="205" cy="120" r="1.1"/><circle cx="210" cy="120" r="1.1"/><circle cx="192.5" cy="124" r="1.1"/><circle cx="197.5" cy="124" r="1.1"/><circle cx="202.5" cy="124" r="1.1"/><circle cx="207.5" cy="124" r="1.1"/></g>
  </g>
  <g class="calls">
  <g class="call" data-call="page" data-for="l2"><polyline points="328,106 270,58 262,58"/><circle cx="328" cy="106" r="2.6"/><text x="256" y="58" text-anchor="end"><tspan class="cn">L2</tspan><tspan x="256" dy="18" class="cw">A page up<tspan class="ck"> · Page Up</tspan></tspan></text></g>
  <g class="call" data-call="bar" data-for="l1"><polyline points="352,131 270,102 262,102"/><circle cx="352" cy="131" r="2.6"/><text x="256" y="102" text-anchor="end"><tspan class="cn">L1</tspan><tspan x="256" dy="18" class="cw">Top bar, or the section before<tspan class="ck"> · Shift+Tab</tspan></tspan></text></g>
  <g class="call" data-call="notice" data-for="create"><polyline points="408,144 270,146 262,146"/><circle cx="408" cy="144" r="2.6"/><text x="256" y="146" text-anchor="end"><tspan class="cn">Create</tspan><tspan x="256" dy="18" class="cw">Close the newest notice<tspan class="ck"> · Delete</tspan></tspan></text></g>
  <g class="call" data-call="move" data-for="dp"><polyline points="321,192 270,198 262,198"/><circle cx="321" cy="192" r="2.6"/><text x="256" y="198" text-anchor="end"><tspan class="cn">D-pad</tspan><tspan x="256" dy="18" class="cw">Move<tspan class="ck"> · Arrow keys</tspan></tspan></text></g>
  <g class="call" data-call="move" data-for="ls"><polyline points="410,252 270,262 262,262"/><circle cx="410" cy="252" r="2.6"/><text x="256" y="262" text-anchor="end"><tspan class="cn">Left stick</tspan><tspan x="256" dy="18" class="cw">Move</tspan></text></g>
  <g class="call" data-call="page" data-for="r2"><polyline points="632,106 690,58 698,58"/><circle cx="632" cy="106" r="2.6"/><text x="704" y="58" text-anchor="start"><tspan class="cn">R2</tspan><tspan x="704" dy="18" class="cw">A page down<tspan class="ck"> · Page Down</tspan></tspan></text></g>
  <g class="call" data-call="bar" data-for="r1"><polyline points="608,131 690,102 698,102"/><circle cx="608" cy="131" r="2.6"/><text x="704" y="102" text-anchor="start"><tspan class="cn">R1</tspan><tspan x="704" dy="18" class="cw">Top bar, or the section after<tspan class="ck"> · Tab</tspan></tspan></text></g>
  <g class="call" data-call="menu" data-for="options"><polyline points="552,144 690,146 698,146"/><circle cx="552" cy="144" r="2.6"/><text x="704" y="146" text-anchor="start"><tspan class="cn">Options</tspan><tspan x="704" dy="18" class="cw">The game’s menu<tspan class="ck"> · Menu</tspan></tspan></text></g>
  <g class="call" data-call="search" data-for="tri"><polyline points="628,167 690,186 698,186"/><circle cx="628" cy="167" r="2.6"/><text x="704" y="186" text-anchor="start"><tspan class="cn">△ Triangle</tspan><tspan x="704" dy="18" class="cw">Search<tspan class="ck"> · /</tspan></tspan></text></g>
  <g class="call" data-call="back" data-for="cir"><polyline points="652,191 690,226 698,226"/><circle cx="652" cy="191" r="2.6"/><text x="704" y="226" text-anchor="start"><tspan class="cn">○ Circle</tspan><tspan x="704" dy="18" class="cw">Back<tspan class="ck"> · Esc</tspan></tspan></text></g>
  <g class="call" data-call="trailer" data-for="sq"><polyline points="592,203 592,306 698,306"/><circle cx="592" cy="203" r="2.6"/><text x="704" y="306" text-anchor="start"><tspan class="cn">□ Square</tspan><tspan x="704" dy="18" class="cw">The game’s trailer<tspan class="ck"> · T</tspan></tspan></text></g>
  <g class="call" data-call="select" data-for="crs"><polyline points="624,223 690,266 698,266"/><circle cx="624" cy="223" r="2.6"/><text x="704" y="266" text-anchor="start"><tspan class="cn">✕ Cross</tspan><tspan x="704" dy="18" class="cw">Select<tspan class="ck"> · Enter</tspan></tspan></text></g>
    <g class="call" data-call="home" data-for="ps"><polyline points="480,242 480,390"/><circle cx="480" cy="242" r="2.6"/><text x="480" y="408" text-anchor="middle"><tspan class="cn">PS button</tspan><tspan x="480" dy="18" class="cw">Tap: Home · Hold: close the game, or the power menu</tspan></text></g>
  </g>
</svg>
    </div>
  </div>
  <dl class="keys mt-4 hidden grid-cols-5 gap-2.5 max-lg:grid-cols-3 max-md:grid max-sm:grid-cols-1" data-stagger>
    {keys.map(({ act, button, key, does }) => (
      <div
        class="rounded-[14px] border border-line bg-panel px-3.5 py-3 transition-colors duration-150 [&.on]:border-ice [&.on]:bg-[#15324b]"
        data-key={act}
      >
        <dt class="text-small font-bold">
          {button}
          {key && <kbd>{key}</kbd>}
        </dt>
        <dd class="mt-1 text-[13.5px] leading-[1.4] text-muted">{does}</dd>
      </div>
    ))}
  </dl>
</section>
