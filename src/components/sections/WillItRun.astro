---
// Will it run? The three answers a game's page gives: the community's list for PS4 (and PS5),
// ProtonDB for some PC games, and what this PC can do. The facts are the launcher's: the levels'
// words from crates/core/src/view.rs, the verdicts from crates/core/src/hardware.rs.

// How far a game gets, from the worst to the best, as the launcher words it.
const levels = ["Doesn't start", "Boots", "Menus", "In-game", "Playable"];

// What each console's emulator needs: its plugin.toml, [requires] and [requires.recommended].
const emulators = [
  { name: "PS4", vulkan: 1.3, avx2: true, threads: 8, memory: 7.0, gpuMemory: 3.5, discrete: true },
  { name: "PS5", vulkan: 1.3, avx2: false, threads: 12, memory: 14.5, gpuMemory: 7.5, discrete: true },
];

// Three example PCs. `gpuMemory` is null for graphics that share the system's memory.
const pcs = [
  {
    id: "gaming",
    name: "Gaming PC",
    specs: "16 threads, 32 GB of memory, a graphics card of 12 GB",
    threads: 16,
    memory: 32,
    avx2: true,
    vulkan: 1.3,
    discrete: true,
    gpuMemory: 12,
  },
  {
    id: "laptop",
    name: "Thin laptop",
    specs: "8 threads, 16 GB of memory, graphics in the processor",
    threads: 8,
    memory: 16,
    avx2: true,
    vulkan: 1.3,
    discrete: false,
    gpuMemory: null,
  },
  {
    id: "older",
    name: "Older PC",
    specs: "4 threads, 8 GB of memory, a graphics card of 4 GB, a processor without AVX2",
    threads: 4,
    memory: 8,
    avx2: false,
    vulkan: 1.3,
    discrete: true,
    gpuMemory: 4,
  },
];

// The launcher's verdict for one PC and one emulator, in the order hardware.rs checks: what stops
// the games first, then the first reason they would be slow.
function verdict(pc, emu) {
  if (pc.vulkan < emu.vulkan) return { level: "no", headline: "Won't start", why: `No Vulkan ${emu.vulkan}` };
  if (emu.avx2 && !pc.avx2) return { level: "no", headline: "Won't start", why: "No AVX2 in the processor" };
  const why =
    emu.discrete && !pc.discrete
      ? "Integrated GPU"
      : pc.gpuMemory !== null && pc.gpuMemory < emu.gpuMemory
        ? `${Math.round(pc.gpuMemory)} GB GPU`
        : pc.threads < emu.threads
          ? `${pc.threads}-thread CPU`
          : pc.memory < emu.memory
            ? `${Math.round(pc.memory)} GB RAM`
            : "";
  return why ? { level: "slow", headline: "May run slowly", why } : { level: "good", headline: "Should run well", why };
}
const results = pcs.map((pc) => {
  const rows = emulators.map((emu) => ({ name: emu.name, ...verdict(pc, emu) }));
  const blocked = rows.filter((row) => row.level === "no");
  // The notice the launcher posts once for a PC that can't run a console's games.
  const notice = blocked.length
    ? `This PC can't run ${blocked.map((row) => row.name).join(" or ")} games: ${[...new Set(blocked.map((row) => row.why))].join(", ")}`
    : "";
  return { ...pc, rows, notice };
});
---

<section class="wrap pt-22 pb-6 max-sm:pt-16" id="will-it-run" aria-labelledby="run-title">
  <div class="text-center" data-reveal>
    <p class="eyebrow">Will it run?</p>
    <h2 class="mt-4 mb-3 text-section" id="run-title">
      Know before you press Play.
    </h2>
    <p class="mx-auto max-w-[760px] text-lead text-muted">
      A game's page answers in its fact cards: what other players found, and what this PC can do.
    </p>
  </div>
  <div class="mt-10 grid grid-cols-3 gap-5 max-lg:grid-cols-2 max-md:grid-cols-1" data-stagger>
    <article
      class="flex flex-col gap-4 rounded-3xl border border-line bg-panel p-7 max-sm:p-[22px]"
      data-run="community"
    >
      <div class="fact" aria-hidden="true">
        <span class="fact-label">Compatibility</span>
        <span class="fact-value">In-game</span>
      </div>
      <h3 class="text-[22px]">PS4: the community's list</h3>
      <p class="text-body text-muted">
        Marah Launcher reads shadPS4's compatibility list for your system, Linux, macOS or Windows. Each PS4 game shows
        how far it gets, and when it was last tested:
      </p>
      <ol class="flex flex-wrap gap-1.5" aria-label="The levels, from the worst to the best">
        {levels.map((level) => (
          <li
            class:list={[
              "rounded-full border border-edge px-3 py-0.5 text-caption font-semibold",
              level === "In-game" && "border-ice bg-ice text-bg",
            ]}
          >
            {level}
          </li>
        ))}
      </ol>
      <p class="hint">
        PS5 games get KytyPS5's list in the same way. A game no list has shows "Not tested". When a game closes, Marah
        Launcher may ask how far it got, and keeps your answer: <strong>Rate how it runs</strong>, in the game's menu,
        asks again.
      </p>
    </article>

    <article
      class="flex flex-col gap-4 rounded-3xl border border-line bg-panel p-7 max-sm:p-[22px]"
      data-run="protondb"
    >
      <div class="fact" aria-hidden="true">
        <span class="fact-label">ProtonDB</span>
        <span class="fact-value">Gold</span>
      </div>
      <h3 class="text-[22px]">Some PC games: ProtonDB</h3>
      <p class="text-body text-muted">
        A Windows game from the Catalog that runs with Wine, and that Steam also has, gets ProtonDB's rating: Platinum,
        Gold, Silver, Bronze or Borked.
      </p>
      <p class="hint">
        The game's menu links to its ProtonDB page, beside <strong>Compatibility list</strong>. When Marah Launcher is
        the whole screen, the items that open a web page don't show.
      </p>
    </article>

    <article
      class="flex flex-col gap-4 rounded-3xl border border-line bg-panel p-7 max-lg:col-span-full max-sm:p-[22px]"
      data-run="this-pc"
    >
      <div class="fact" aria-hidden="true">
        <span class="fact-label">On this PC</span>
        <span class="fact-value">Should run well</span>
      </div>
      <h3 class="text-[22px]">On this PC: from what it needs</h3>
      <p class="text-body text-muted">
        Marah Launcher reads the processor, the memory and the graphics, and checks them against what each emulator
        needs. Pick a PC to see what Settings → This PC says:
      </p>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Choose an example PC" data-pc-switcher hidden>
        {results.map((pc, i) => (
          <button
            type="button"
            class="chip-button px-4 py-1.5 text-small"
            aria-pressed={String(i === 0)}
            data-pc={pc.id}
          >
            {pc.name}
          </button>
        ))}
      </div>
      <div class="grid gap-4" aria-live="polite">
        {results.map((pc) => (
          <div class="grid gap-2" data-pc-panel={pc.id}>
            <p class="text-caption text-muted">
              <strong class="text-text">{pc.name}:</strong> {pc.specs}.
            </p>
            <ul class="grid gap-1.5">
              {pc.rows.map((row) => (
                <li class="verdict" data-level={row.level}>
                  <span class="font-bold">{row.name}</span>
                  <span class="verdict-text">
                    {row.headline}
                    {row.why && <span class="text-muted"> · {row.why}</span>}
                  </span>
                </li>
              ))}
            </ul>
            {pc.notice && <p class="hint">The notice it shows once: "{pc.notice}".</p>}
          </div>
        ))}
      </div>
    </article>
  </div>
  <p class="mt-5 text-center text-caption text-muted">
    Examples. The words are the launcher's own; the levels and ratings come from each list.
  </p>
</section>
