---
// Add a game by hand: a PC game's folder, and the files that tell Marah Launcher about it.
// The facts come from the launcher's docs/user-guide.md ("Adding a PC game by hand") and
// docs/reference/archives-and-pc-games.md.
import CodeCard from "../ui/CodeCard.astro";

const docs = "https://github.com/MarahHQ/marah-launcher/blob/main/docs";

const tree = `My Game/
├── start.sh
├── MyGame.x86_64
├── MyGame.exe
├── launcher_game.json
└── launcher_art/
    ├── cover.jpg
    ├── background.jpg
    ├── logo.png
    └── screenshot_1.jpg`;

const gameFile = `{
  "format": 1,
  "title": "My Game",
  "description": "A short line about the game.",
  "genres": ["Puzzle"],
  "release": "2026-03-14",
  "starts": [
    { "kind": "script", "path": "start.sh" },
    { "kind": "native", "path": "MyGame.x86_64" },
    { "kind": "windows", "path": "MyGame.exe" }
  ],
  "art": {
    "cover": "launcher_art/cover.jpg",
    "background": "launcher_art/background.jpg",
    "logo": "launcher_art/logo.png",
    "screenshots": ["launcher_art/screenshot_1.jpg"]
  }
}`;

const startScript = `#!/bin/sh
# Starts the game from its own folder, in full screen.
cd "$(dirname "$0")"
exec ./MyGame.x86_64 --fullscreen`;

const steps = [
  {
    title: "Copy the game's folder into PC/",
    text: "In a game folder: <code>~/Games/PC/</code> unless you chose others in Settings → Games. One folder is one game. A game that is already unpacked needs no install.",
  },
  {
    title: "Give it a cover, if you like",
    text: "Put <code>cover.jpg</code>, <code>cover.png</code> or <code>cover.webp</code> in the game's folder.",
  },
  {
    title: "Rescan",
    text: "In Settings → Games, choose <b>Rescan game folders</b>. Marah Launcher looks through the folder, finds every file that can start the game, and writes <code>launcher_game.json</code> beside them.",
  },
  {
    title: "Or write that file yourself",
    text: 'Name the game, choose what starts it, best first, and point to its art in <code>launcher_art/</code>. Keep <code>"format": 1</code>: a file without it is skipped.',
  },
  {
    title: "Start it your way, on Linux",
    text: "A <code>start.sh</code> runs first when it is listed first. A script without <code>#!</code> runs with <code>sh</code>.",
  },
];
---

<section class="border-t border-line py-24 max-sm:py-16" id="add-game" aria-labelledby="add-game-title">
  <div class="wrap grid grid-cols-[1fr_1.05fr] items-start gap-x-18 gap-y-10 max-md:grid-cols-1 max-md:gap-8">
    <div data-reveal>
      <p class="eyebrow">Add a game</p>
      <h2 class="mt-4 mb-5 text-section" id="add-game-title">
        Bring a game you have.
        <br />
        <span class="accent-text">It does the rest.</span>
      </h2>
      <p class="my-[1em] max-w-[560px] text-lead text-muted">
        Marah Launcher finds a PC game in your game folders and works out what starts it. A few files let you say more:
        its name, its art, and how it starts.
      </p>
      <ol class="mt-8 grid gap-5">
        {steps.map((step, i) => (
          <li class="flex gap-4">
            <span class="grid size-9 flex-none place-items-center rounded-full border border-edge bg-panel font-display text-[15px] font-bold text-ice">
              {i + 1}
            </span>
            <div class="[&_code]:text-[13.5px] [&_code]:text-text">
              <h3 class="text-lead">{step.title}</h3>
              <p class="mt-1 text-body text-muted" set:html={step.text} />
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-8 hint">
        The kinds a start can be: <code class="text-text">script</code>, <code class="text-text">appimage</code> and
        <code class="text-text">native</code> run on Linux, <code class="text-text">macapp</code> on macOS, and
        <code class="text-text">windows</code> everywhere, with Proton or Wine off Windows. Every rule is in
        <a href={`${docs}/reference/archives-and-pc-games.md`}>the reference</a>.
      </p>
    </div>
    <div class="grid gap-5" data-stagger>
      <CodeCard name="~/Games/PC/" text={tree} />
      <CodeCard name="launcher_game.json" text={gameFile} id="add-game-json" />
      <CodeCard name="start.sh" text={startScript} id="add-game-script" />
    </div>
  </div>
</section>
