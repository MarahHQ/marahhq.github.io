---
// The screenshots, and the buttons that switch them.
---

<section
  class="relative overflow-hidden border-t border-line pt-18 pb-24 [background:radial-gradient(ellipse_at_30%_60%,rgba(76,139,220,.25),transparent_55%),var(--color-deep)] max-sm:pt-12 max-sm:pb-16"
  id="screens"
  aria-labelledby="screens-title"
>
  <div class="wrap grid grid-cols-2 items-center gap-18 *:min-w-0 max-md:grid-cols-1 max-md:gap-8">
    <figure class="screen-stack relative px-5 pt-6" data-reveal>
      <div class="screen-back" aria-hidden="true"></div>
      <img
        id="screen"
        src="assets/screen-home.webp"
        alt="The Marah Launcher home screen: a list of game sources on the right, with All games, Steam, PC, Nintendo Switch and PlayStation 5"
        width="1600"
        height="900"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="mt-7 text-center text-caption text-muted">Default theme, with a real library.</figcaption>
    </figure>
    <div class="max-md:text-center" data-reveal style="--i: 1">
      <p class="pill">The experience</p>
      <h2 class="my-5 text-[clamp(30px,3.1vw,46px)]" id="screens-title">
        A home for your games on the TV
      </h2>
      <p class="my-[1em] text-lead text-muted">
        Marah Launcher finds your games and shows their art and details. It downloads and updates the emulators,
        installs games and starts them. When a game closes, it comes back to the front.
      </p>
      <div
        class="switcher mt-6 flex flex-wrap gap-2.5 max-md:justify-center"
        role="group"
        aria-label="Choose a screenshot"
        hidden
      >
        <button
          type="button"
          class="chip-button"
          aria-pressed="true"
          data-src="assets/screen-home.webp"
          data-alt="The Marah Launcher home screen: a list of game sources on the right, with All games, Steam, PC, Nintendo Switch and PlayStation 5"
        >
          Home
        </button>
        <button
          type="button"
          class="chip-button"
          aria-pressed="false"
          data-src="assets/screen-library.webp"
          data-alt="The Library: a grid of game covers from Steam, PC, Switch and PS5, with search, sort and genre filters above them"
        >
          Library
        </button>
        <button
          type="button"
          class="chip-button"
          aria-pressed="false"
          data-src="assets/screen-hub.webp"
          data-alt="A game's page: its cover, a Play button, how well it runs on this PC, its size and screenshots"
        >
          Game page
        </button>
        <button
          type="button"
          class="chip-button"
          aria-pressed="false"
          data-src="assets/screen-settings.webp"
          data-alt="The Settings screen on one page: a rail of section icons, the Games section with its folders and a Rescan button, then Downloads"
        >
          Settings
        </button>
      </div>
    </div>
  </div>
</section>
