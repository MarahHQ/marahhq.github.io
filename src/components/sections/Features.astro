---
// The four things it is, in a strip.
---

<section
  class="wrap grid grid-cols-4 gap-6 border-y border-line py-7 max-lg:grid-cols-2 max-sm:grid-cols-1"
  id="features"
  aria-label="Features"
  data-stagger
>
  <article class="group flex items-center gap-4">
    <div class="icon group-hover:-translate-y-[3px] group-hover:-rotate-4 group-hover:border-ice" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <rect x="3" y="3" width="7" height="7" rx="2" />
        <rect x="14" y="3" width="7" height="7" rx="2" />
        <rect x="3" y="14" width="7" height="7" rx="2" />
        <rect x="14" y="14" width="7" height="7" rx="2" />
      </svg>
    </div>
    <div>
      <h2 class="mb-1.5 text-lead tracking-[-.01em]">One library</h2>
      <p class="text-small text-muted">Games from emulators, PC folders and Steam, in one place.</p>
    </div>
  </article>
  <article class="group flex items-center gap-4">
    <div class="icon group-hover:-translate-y-[3px] group-hover:-rotate-4 group-hover:border-ice" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <path d="M7 8h10a4 4 0 0 1 4 4v3a3 3 0 0 1-5.4 1.8L14 15h-4l-1.6 1.8A3 3 0 0 1 3 15v-3a4 4 0 0 1 4-4z" />
        <path d="M8 11v3M6.5 12.5h3" />
        <circle cx="16" cy="12" r=".6" />
      </svg>
    </div>
    <div>
      <h2 class="mb-1.5 text-lead tracking-[-.01em]">Made for a controller</h2>
      <p class="text-small text-muted">Every screen works with a pad. A keyboard and a mouse work too.</p>
    </div>
  </article>
  <article class="group flex items-center gap-4">
    <div class="icon group-hover:-translate-y-[3px] group-hover:-rotate-4 group-hover:border-ice" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.5-.8 1.5-1.5 0-1.2-1-1.5-1-2.5s.7-1.5 1.7-1.5H17a4 4 0 0 0 4-4c0-4.7-4-8.5-9-8.5z" />
        <circle cx="7.5" cy="11" r="1" />
        <circle cx="11" cy="7" r="1" />
        <circle cx="16" cy="8.5" r="1" />
      </svg>
    </div>
    <div>
      <h2 class="mb-1.5 text-lead tracking-[-.01em]">Themes you can swap</h2>
      <p class="text-small text-muted">The screens are Slint themes. A theme changes the whole layout.</p>
    </div>
  </article>
  <article class="group flex items-center gap-4">
    <div class="icon group-hover:-translate-y-[3px] group-hover:-rotate-4 group-hover:border-ice" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="24" height="24">
        <path d="M8 7l-5 5 5 5M16 7l5 5-5 5M13.5 4l-3 16" />
      </svg>
    </div>
    <div>
      <h2 class="mb-1.5 text-lead tracking-[-.01em]">Free software</h2>
      <p class="text-small text-muted">GPL-3.0-or-later. Read the code, change it, share it.</p>
    </div>
  </article>
</section>
