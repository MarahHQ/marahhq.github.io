---
// Dark or light, in the head of every page: the browser bar's colour, and a script that sets the
// theme before the first paint. Without JavaScript, the media attributes and site.css follow the
// system's setting.
---

<!-- The browser bar's colour: the script and site.js write data-dark or data-light into both. -->
<meta
  name="theme-color"
  content="#0d1926"
  media="(prefers-color-scheme: dark)"
  data-dark="#0d1926"
  data-light="#f2f6fa"
/>
<meta
  name="theme-color"
  content="#f2f6fa"
  media="(prefers-color-scheme: light)"
  data-dark="#0d1926"
  data-light="#f2f6fa"
/>
<meta name="color-scheme" content="dark light" />
<script is:inline>
  // The visitor's choice (site.js keeps it), else the system's setting.
  (function () {
    var theme = null;
    try {
      theme = localStorage.getItem("marah-theme");
    } catch (e) {}
    if (theme !== "light" && theme !== "dark") {
      theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
    }
    document.documentElement.dataset.theme = theme;
    document.querySelectorAll('meta[name="theme-color"]').forEach(function (bar) {
      bar.content = bar.dataset[theme];
    });
  })();
</script>
