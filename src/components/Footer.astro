---
// The footer: the logo, the notes and the links.
---

<footer class="border-t border-line">
  <div class="wrap flex items-center justify-between gap-8 py-10 max-sm:flex-col max-sm:text-center">
    <a
      class="flex items-center gap-3 font-display text-[20px] leading-[1.05] font-extrabold tracking-[-.03em] text-text no-underline max-sm:text-[17px]"
      href="#top"
    >
      <img
        class="drop-shadow-[0_0_10px_rgba(130,216,245,.35)] light:[filter:drop-shadow(0_0_1px_#0d1926)_drop-shadow(0_2px_4px_rgba(13,25,38,.35))] max-sm:size-10"
        src="assets/logo-mark.svg"
        alt=""
        width="44"
        height="44"
        loading="lazy"
        decoding="async"
      />
      <span>
        Marah
        <br />
        Launcher
      </span>
    </a>
    <div>
      <p class="my-1 text-small text-muted">All your games. One launcher. Inspired by Azrak.</p>
      <p class="my-1 text-small text-muted">
        Marah Launcher comes with no games. Play only games you are allowed to use.
      </p>
      <p class="my-1 text-small text-muted">PlayStation, Nintendo Switch and Steam are trademarks of their owners.</p>
    </div>
    <ul class="flex flex-wrap gap-5 max-sm:justify-center">
      <li>
        <a class="text-body" href="https://github.com/MarahHQ/marah-launcher">
          Marah Launcher
        </a>
      </li>
      <li>
        <a class="text-body" href="https://github.com/MarahHQ/marah-os">
          Marah OS
        </a>
      </li>
      <li>
        <a class="text-body" href="https://github.com/MarahHQ/marah-launcher/blob/main/LICENSE">
          License
        </a>
      </li>
    </ul>
  </div>
</footer>
