---
// The page for a missing address. Its paths start with "/": it is served at any depth.
import "../styles/site.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d1926" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex" />
    <title>Page not found · Marah Launcher</title>
    <link rel="icon" href="/assets/logo-static.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/assets/icon-180.png" />
  </head>
  <body>
    <main class="grid min-h-screen place-content-center justify-items-center gap-2 p-8 text-center">
      <img
        class="w-[220px] drop-shadow-[0_10px_22px_rgba(130,216,245,.3)]"
        src="/assets/mascot.webp"
        alt="The Marah mascot, a smiling gamepad"
        width="720"
        height="720"
      />
      <p class="eyebrow max-w-[460px] text-lead text-muted">Error 404</p>
      <h1 class="mt-4 text-[clamp(34px,5vw,56px)]">
        This level <span class="accent-text">isn't here.</span>
      </h1>
      <p class="max-w-[460px] text-lead text-muted">
        The page you were looking for moved, or never was. Start again from Home.
      </p>
      <div class="mt-7 flex flex-wrap gap-3.5">
        <a class="cta" href="/">
          Back to Home
        </a>
        <a class="btn-outline" href="/#get">
          Get Marah Launcher
        </a>
      </div>
    </main>
  </body>
</html>
